<configs>
    <append xpath="/lootcontainers">
        <lootcontainer name="junkdestroy" count="1,2" size="5,3" sound_open="UseActions/open_garbage" sound_close="UseActions/close_garbage" loot_quality_template="qualBaseTemplate" destroy_on_close="empty">
            <item group="groupJunk" />
        </lootcontainer>
    </append>
    <setattribute xpath="//lootcontainer[@name='purse']" name="destroy_on_close">empty</setattribute>
    <setattribute xpath="//lootcontainer[@name='birdNest']" name="destroy_on_close">empty</setattribute>
    <setattribute xpath="//lootcontainer[@name='cntBackpack']" name="destroy_on_close">empty</setattribute>
    <setattribute xpath="//lootcontainer[@name='closet']" name="destroy_on_close">empty</setattribute>
    <setattribute xpath="//lootcontainer[@name='luggage']" name="destroy_on_close">empty</setattribute>
</configs>
